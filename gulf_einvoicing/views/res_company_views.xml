<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_gulf_einvoicing" model="ir.ui.view">
        <field name="name">res.company.form.gulf.einvoicing</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Gulf E-Invoicing" name="gulf_einvoicing">
                    <field name="gulf_einvoicing_enabled"/>
                    <field name="gulf_einvoicing_country"
                           invisible="not gulf_einvoicing_enabled"/>
                    <field name="gulf_cr_number"
                           invisible="not gulf_einvoicing_enabled"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_gulf_einvoicing" model="ir.ui.view">
        <field name="name">account.move.form.gulf.einvoicing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_generate_gulf_einvoice"
                        type="object"
                        string="Generate E-Invoice"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice' or state == 'cancel'"
                        groups="base.group_user"/>
                <button name="action_reset_gulf_einvoice"
                        type="object"
                        string="Reset E-Invoice"
                        invisible="gulf_einvoice_state != 'generated'"
                        groups="base.group_user"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Gulf E-Invoice" name="gulf_einvoice"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Configuration">
                            <field name="gulf_einvoice_type"/>
                            <field name="gulf_einvoice_state"/>
                            <field name="gulf_einvoice_uuid"
                                   invisible="not gulf_einvoice_uuid"/>
                            <field name="gulf_einvoice_generated_on"
                                   invisible="not gulf_einvoice_generated_on"/>
                        </group>
                        <group string="Files">
                            <field name="gulf_einvoice_xml"
                                   filename="gulf_einvoice_filename"
                                   invisible="not gulf_einvoice_xml"/>
                            <field name="gulf_einvoice_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="ZATCA Phase 1 QR Payload (base64 TLV)">
                        <field name="gulf_einvoice_qr"
                               nolabel="1"
                               colspan="2"
                               widget="CopyClipboardText"
                               placeholder="Press 'Generate E-Invoice' to build the QR payload."/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
